# .env.example
# Copy this file to .env and configure your secrets.
# Do NOT commit your actual .env file to version control.

# Vapi Integration Keys (Telephony & Voice agent platform)
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Groq LLM API Key (used for resume analysis & post-call evaluations)
GROQ_API_KEY=your_groq_api_key_here
# Optional: defaults to openai/gpt-oss-20b when unset.
GROQ_MODEL=openai/gpt-oss-20b
# Realtime Vapi model. Keep separate from the model used by backend evaluation.
VAPI_GROQ_MODEL=llama-3.1-8b-instant

# Judge0 code-execution service. Keep its token server-side; never expose it to the browser.
JUDGE0_API_URL=https://your-judge0-instance.example.com
JUDGE0_AUTH_TOKEN=your_judge0_auth_token_here

# Supabase server credentials. Do not use a SUPABASE_* key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
