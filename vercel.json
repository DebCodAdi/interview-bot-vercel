{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build"
    }
  },
  "rewrites": [
    {
      "source": "/resume/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/interview/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/coding-api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
